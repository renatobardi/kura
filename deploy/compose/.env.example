# Kura production Docker Compose environment.
# Copy to .env and replace every CHANGE_ME value before running.
# The bootstrap script should generate this file for normal users.

# Image published by the public image pipeline. Use `:main` for pre-release testing. Pin `:sha-<7>` or a semver release tag for production.
KURA_IMAGE=ghcr.io/block/kura:main

# Public host name. Used by compose.caddy.yml and URL-derived settings below.
KURA_DOMAIN=kura.example.com
RELAY_URL=wss://kura.example.com
KURA_MEDIA_BASE_URL=https://kura.example.com/media
KURA_MEDIA_SERVER_DOMAIN=kura.example.com
KURA_CORS_ORIGINS=https://kura.example.com

# Production defaults. Closed relay mode requires RELAY_OWNER_PUBKEY and a stable relay key.
KURA_REQUIRE_AUTH_TOKEN=true
KURA_REQUIRE_RELAY_MEMBERSHIP=true
KURA_ALLOW_NIP_OA_AUTH=true
KURA_AUTO_MIGRATE=true
KURA_GIT_CONFORMANCE_PROBE=true
RUST_LOG=kura_relay=info,kura_db=info,kura_auth=info,kura_pubsub=info,tower_http=info

# Owner identity. Set to a 64-character hex Nostr pubkey.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets. Generate once, keep in .env, and back up securely.
KURA_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
KURA_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=kura
POSTGRES_USER=kura
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
KURA_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
KURA_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
KURA_S3_BUCKET=kura-media
# Bundled MinIO uses path-style URLs; deploy/compose/compose.yml pins this.
KURA_S3_ADDRESSING_STYLE=path

# Optional private moderation dashboard. Set KURA_ADMIN_HOST plus KURA_ADMIN_AUTH:
#   KURA_ADMIN_AUTH=nip98 (default) — NIP-98 HTTP Auth via Nostr pubkey-based auth.
#     Authorized principals resolve from RELAY_OPERATOR_PUBKEYS (config Operators),
#     RELAY_OWNER_PUBKEY (implicit Operator fallback when operator list is empty),
#     and the relay_operators table (DB-managed Operator/Moderator roster).
#     Dashboard requires a NIP-07 browser extension (nos2x or Alby).
#   KURA_ADMIN_AUTH=disabled — no auth. Use only behind a VPN or private ingress.
#     Relay logs a WARN on boot.
# Token authentication was removed: KURA_ADMIN_TOKEN is ignored with a startup
# warning — remove it from the environment.
# Any unrecognised KURA_ADMIN_AUTH value aborts startup.
# When KURA_ADMIN_HOST is set, the relay advertises the admin origin in its NIP-11
# document (`admin_api` field) so clients auto-discover the console without manual entry.
# Setting RELAY_OPERATOR_PUBKEYS for the console does NOT require RELAY_OPERATOR_API_ORIGIN;
# that origin is only for community provisioning (POST /operator/communities), which fails
# closed at request time until it is set (the relay boots with a WARN in the meantime).
# KURA_ADMIN_HOST=admin.kura.example.com
# KURA_ADMIN_AUTH=nip98
# RELAY_OPERATOR_PUBKEYS=<64-char hex pubkey>[,<64-char hex pubkey>...]
# RELAY_OPERATOR_API_ORIGIN=https://admin.kura.example.com

# Optional host ports. Base compose publishes the relay directly on KURA_HTTP_PORT.
KURA_HTTP_PORT=3000

# Caddy host ports. Only used with compose.caddy.yml.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Dev override ports. Only used with compose.dev.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ADMINER_PORT=8082
PROMETHEUS_PORT=9090
